# ==========================================
# QuizWeb Environment Configuration Template
# ==========================================
# Create a .env.local file in the root directory and populate these values.

# ------------------------------------------
# 1. Next-Auth / Auth.js (v5 Beta)
# ------------------------------------------
# Secret key used to sign and encrypt JWT session tokens.
# Generate via: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_minimum_32_characters_here

# Required for local development outside Vercel (prevents UntrustedHost error)
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth Provider Credentials
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret

# ------------------------------------------
# 2. MySQL Database Connection (mysql2)
# ------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=quizweb

# ------------------------------------------
# 3. Resend Email Delivery
# ------------------------------------------
# Resend API Key for signup verification and OTP emails.
# WARNING: lib/email.ts throws on startup if this is missing or empty.
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------
# 4. Google reCAPTCHA v3
# ------------------------------------------
# NEXT_PUBLIC_ prefix is strictly required by Next.js to expose the key to the browser.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ------------------------------------------
# 5. Role-Based Access Control (RBAC) & Administration
# ------------------------------------------
# Server-side secret key / invite code guarding administrative elevation (R3).
# Users with set passwords supply this key to claim admin privileges, or
# existing admins supply it in the dashboard to promote a user to admin.
# Minimum 32 characters recommended for production.
# Generate via: openssl rand -base64 32
ADMIN_SECRET_KEY=your_admin_secret_key_minimum_32_characters_here
