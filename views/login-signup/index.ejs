<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuizWeb | Sign In</title>
  <link rel="stylesheet" href="../../public/css/login-signup.css">
</head>
<body class="auth-page">
  <main class="auth-card" id="auth">
    <section class="info" aria-label="Authentication info">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">
        </div>
        <span>QuizWeb</span>
      </div>

      <div class="panel">
        <p class="tag" id="panelLabel">Minimal access</p>
        <h1 id="panelTitle">Welcome back</h1>
        <p id="panelText">Continue your quiz streak where you left off.</p>
      </div>
    </section>

    <section class="formPanel" aria-label="Authentication form">
      <div class="formCard">
        <header class="formHead">
          <p class="eyebrow" id="formLabel">Access your account</p>
          <h2 id="formTitle">Sign in</h2>
          <p class="helper" id="formText">Use your email and password to continue.</p>
        </header>

        <div class="stack">
          <div id="signIn" class="formView active">
            <label class="input-group">
              <span class="field-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
              </span>
              <input type="email" placeholder="Email address" autocomplete="email">
            </label>

            <label class="input-group">
              <span class="field-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" placeholder="Password" autocomplete="current-password">
            </label>

            <div class="formActions">
              <a class="forgot-link" href="#forgot-password">Forgot Password?</a>
            </div>

            <button type="button" class="submit-btn">Sign in</button>

            <div class="divider-row" aria-hidden="true">
              <span class="divider-line"></span>
              <span class="divider-text">OR</span>
              <span class="divider-line"></span>
            </div>

            <button type="button" class="social-btn">
              <span class="social-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30"><path d="M 15.003906 3 C 8.3749062 3 3 8.373 3 15 C 3 21.627 8.3749062 27 15.003906 27 C 25.013906 27 27.269078 17.707 26.330078 13 L 25 13 L 22.732422 13 L 15 13 L 15 17 L 22.738281 17 C 21.848702 20.448251 18.725955 23 15 23 C 10.582 23 7 19.418 7 15 C 7 10.582 10.582 7 15 7 C 17.009 7 18.839141 7.74575 20.244141 8.96875 L 23.085938 6.1289062 C 20.951937 4.1849063 18.116906 3 15.003906 3 z"></path></svg>
              </span>
              <span>Continue with Google</span>
            </button>
          </div>

          <div id="signUp" class="formView">
            <label class="input-group">
              <span class="field-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" placeholder="Username" autocomplete="name">
            </label>

            <label class="input-group">
              <span class="field-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
              </span>
              <input type="email" placeholder="Email address" autocomplete="email">
            </label>

            <label class="input-group">
              <span class="field-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" placeholder="Create password" autocomplete="new-password">
            </label>

            <button type="button" class="submit-btn">Create account</button>
          </div>
        </div>

        <a id="toggleLink" class="link" href="#signup" data-mode="signup">New here? Create account</a>
      </div>
    </section>
  </main>

  <div id="forgot" class="modal" role="dialog" aria-modal="true" aria-label="Forgot password">
    <div class="modalBox">
      <button type="button" class="modalClose" aria-label="Close forgot password">×</button>

      <div class="modalHead">
        <p class="eyebrow" id="stepLabel">Step 1</p>
        <h3 id="stepTitle">Enter your email</h3>
        <p class="modalCopy" id="stepText">Use the registered email address for your account.</p>
      </div>

      <div class="step active" id="step1">
        <label class="input-group modal-input">
          <span class="field-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
          </span>
          <input type="email" placeholder="Registered email address" autocomplete="email">
        </label>
        <button type="button" class="submit-btn" data-next-step="2">Send OTP</button>
      </div>

      <div class="step" id="step2">
        <label class="input-group modal-input">
          <span class="field-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="text" placeholder="Enter 6-digit OTP" maxlength="6">
        </label>
        <button type="button" class="submit-btn" data-next-step="3">Verify OTP</button>
      </div>

      <div class="step" id="step3">
        <label class="input-group modal-input">
          <span class="field-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="password" placeholder="New password" autocomplete="new-password">
        </label>
        <label class="input-group modal-input">
          <span class="field-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="password" placeholder="Confirm password" autocomplete="new-password">
        </label>
        <button type="button" class="submit-btn" data-finish="true">Reset Password</button>
      </div>

      <div class="step" id="step4">
        <p class="doneMsg">Password reset complete. You can now return to Sign In.</p>
        <button type="button" class="submit-btn" data-mode="signin">Return to Sign In</button>
      </div>

      <a class="link" href="#signin" data-mode="signin">Back to sign in</a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const card = document.getElementById('auth');
      const signIn = document.getElementById('signIn');
      const signUp = document.getElementById('signUp');
      const modal = document.getElementById('forgot');
      const panelLabel = document.getElementById('panelLabel');
      const panelTitle = document.getElementById('panelTitle');
      const panelText = document.getElementById('panelText');
      const formLabel = document.getElementById('formLabel');
      const formTitle = document.getElementById('formTitle');
      const formText = document.getElementById('formText');
      const toggleLink = document.getElementById('toggleLink');
      const links = document.querySelectorAll('.link');
      const openForgot = document.querySelector('.forgot-link');
      const closeModal = document.querySelector('.modalClose');
      const steps = Array.from(document.querySelectorAll('.step'));
      const stepLabel = document.getElementById('stepLabel');
      const stepTitle = document.getElementById('stepTitle');
      const stepText = document.getElementById('stepText');
      const actionButtons = document.querySelectorAll('.modal .submit-btn');

      function showStep(n) {
        steps.forEach((step) => step.classList.remove('active'));
        document.getElementById(`step${n}`).classList.add('active');

        const copy = {
          1: ['Step 1', 'Enter your email', 'Use the registered email address for your account.'],
          2: ['Step 2', 'Verify OTP', 'A 6-digit code will appear here during future integration.'],
          3: ['Step 3', 'Reset password', 'You can place the new password fields here later.'],
          4: ['Complete', 'All set', 'Your password reset flow is ready for future backend integration.']
        };

        const [label, title, text] = copy[n];
        stepLabel.textContent = label;
        stepTitle.textContent = title;
        stepText.textContent = text;
      }

      function showView(mode) {
        if (mode === 'signup') {
          card.classList.add('is-signup');
          signIn.classList.remove('active');
          signUp.classList.add('active');
          panelLabel.textContent = 'New journey';
          panelTitle.textContent = 'Create account';
          panelText.textContent = 'Start learning with QuizWeb in minutes.';
          formLabel.textContent = 'Get started';
          formTitle.textContent = 'Create account';
          formText.textContent = 'A few details and you’re ready to go.';
          toggleLink.textContent = 'Already have an account? Sign in';
          toggleLink.setAttribute('href', '#signin');
          toggleLink.setAttribute('data-mode', 'signin');
        } else {
          card.classList.remove('is-signup');
          signIn.classList.add('active');
          signUp.classList.remove('active');
          panelLabel.textContent = 'Minimal access';
          panelTitle.textContent = 'Welcome back';
          panelText.textContent = 'Continue your quiz streak where you left off.';
          formLabel.textContent = 'Access your account';
          formTitle.textContent = 'Sign in';
          formText.textContent = 'Use your email and password to continue.';
          toggleLink.textContent = 'New here? Create account';
          toggleLink.setAttribute('href', '#signup');
          toggleLink.setAttribute('data-mode', 'signup');
        }

        window.location.hash = mode === 'signup' ? 'signup' : 'signin';
      }

      links.forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const mode = link.getAttribute('data-mode');
          if (mode === 'signup') {
            showView('signup');
          } else if (mode === 'signin') {
            modal.classList.remove('visible');
            showView('signin');
          }
        });
      });

      openForgot.addEventListener('click', (event) => {
        event.preventDefault();
        modal.classList.add('visible');
        showStep(1);
        window.location.hash = 'forgot-password';
      });

      closeModal.addEventListener('click', () => {
        modal.classList.remove('visible');
        showStep(1);
        window.location.hash = 'signin';
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          modal.classList.remove('visible');
          showStep(1);
          window.location.hash = 'signin';
        }
      });

      actionButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (button.getAttribute('data-next-step') === '2') {
            showStep(2);
          } else if (button.getAttribute('data-next-step') === '3') {
            showStep(3);
          } else if (button.getAttribute('data-finish') === 'true') {
            showStep(4);
          } else if (button.getAttribute('data-mode') === 'signin') {
            modal.classList.remove('visible');
            showView('signin');
          }
        });
      });

      if (window.location.hash === '#signup') {
        showView('signup');
      } else if (window.location.hash === '#forgot-password') {
        modal.classList.add('visible');
        showStep(1);
        showView('signin');
      } else {
        showView('signin');
      }
    });
  </script>
</body>
</html>
